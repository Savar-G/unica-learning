# Copy to .env.local for local dev. In Vercel: Project -> Settings -> Environment Variables (all environments).
RESEND_API_KEY=
SIGNUP_NOTIFY_EMAIL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SITE_URL=https://unicalearning.com
# Keep search indexing off until launch. Vercel preview deployments always remain noindex.
NEXT_PUBLIC_ALLOW_INDEX=false
# Stripe secret or restricted key. Customer/Checkout creation needs write access.
# The thank-you page also retrieves Checkout Sessions with an expanded SetupIntent.
# Verify that the key allows this lookup. Card setup charges nothing.
STRIPE_SECRET_KEY=
# Supabase secret key (server only): account writes for the online assessment. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Online assessment pilot. "on" opens /start, /sign-in and /account; anything else answers 404 (until launch, #82).
ASSESSMENT_PILOT=
