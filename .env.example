# Copy to .env.local for local dev. In Vercel: Project -> Settings -> Environment Variables (all environments).
RESEND_API_KEY=
SIGNUP_NOTIFY_EMAIL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SITE_URL=https://unicalearning.com
# Keep search indexing off until launch. Vercel preview deployments always remain noindex.
NEXT_PUBLIC_ALLOW_INDEX=false
# Stripe secret or restricted key. Customer/Checkout creation needs write access.
# The thank-you page also retrieves Checkout Sessions with an expanded SetupIntent.
# Verify that the key allows this lookup. Card setup charges nothing.
STRIPE_SECRET_KEY=
# Supabase secret key (server only): account writes for the online assessment. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Sender for parent emails (sign-in links, reports, reminders), on a domain verified in Resend.
EMAIL_FROM=
# Protects the reminder and retention jobs (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# OpenRouter API key (server only): turns on the AI work review and the AI report text. Unset means no AI call.
OPENROUTER_API_KEY=
# The OpenRouter model id for every AI feature; default anthropic/claude-sonnet-5.5. It needs image input, structured output and reasoning.
AI_MODEL=
# Development only: sure or unsure runs the report job with a fake AI reviewer, with no key.
AI_REVIEW_FAKE=
