# Maya voice worker secrets template (LiveKit Cloud; see docs/maya-voice.md and docs/maya-voice-deploy.md).
# Copy outside the repository (e.g. ~/.config/unica/maya-voice.env, chmod 600) and pass via `lk agent create --secrets-file`.
# Do NOT put LIVEKIT_URL, LIVEKIT_API_KEY, or LIVEKIT_API_SECRET in the Cloud secrets file: LiveKit Cloud injects them.
# For local dev with `npm run voice:dev` + `livekit-server --dev`, export LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET in your shell.

# Supabase (dedicated worker secret key `maya_voice_worker`)
SUPABASE_URL=https://cdjobwsyzndtltzfpyqa.supabase.co
SUPABASE_SECRET_KEY=

# Dedicated OpenRouter product keys (see docs/ai-product-keys.md; shared OPENROUTER_API_KEY is disabled)
MAYA_OPENROUTER_API_KEY=
# Optional child profile findings after calls (must be distinct from MAYA_OPENROUTER_API_KEY)
PROFILE_OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5.5
# Optional model overrides (defaults: anthropic/claude-haiku-5.5, anthropic/claude-sonnet-5.5)
# MAYA_REVIEW_MODEL=
# MAYA_MATH_REVIEW_MODEL=
# MAYA_MATH_REVIEW_RETRY_MODEL=

# Speech-to-text and voice providers: fake (default), inference (LiveKit Inference), or assemblyai / inworld (direct)
MAYA_STT=fake
MAYA_TTS=fake
# Required when MAYA_STT or MAYA_TTS is not fake (comma-separated markers, e.g. livekit-inference-zdr,child-use-approved)
# MAYA_VOICE_PRIVACY_CONFIRMED=
# Optional provider model and voice overrides
# MAYA_STT_MODEL=assemblyai/universal-3-6-pro
# MAYA_TTS_MODEL=cartesia/sonic-3.6
# MAYA_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
# Only needed for direct (non-Inference) routes
# ASSEMBLYAI_API_KEY=
# INWORLD_API_KEY=

# Rollout & safety alerts
# MAYA_TUTOR_FAMILIES=on
# Dedicated sending-only Resend key (`maya_voice_worker`) for safety alerts
RESEND_API_KEY=
EMAIL_FROM=
SIGNUP_NOTIFY_EMAIL=

# Optional runtime tuning & spend alerts
# MAYA_VOICE_LOAD_LIMIT=
# MAYA_ACK_LIMIT_MS=
# MAYA_DB_TIMING=off
# MAYA_USD_TO_CAD=1.40
# MAYA_MONTHLY_ALERT_CAD=400
# MAYA_STT_USD_PER_MINUTE=0.01
# MAYA_VOICE_USD_PER_1K_CHARS=0.03
