# Design images (mockups, screenshots, stock photos) live in Git LFS, so the git history stays small.
# Only .design: Vercel builds with LFS off, so images the site ships (src/, public/) stay in plain git.
.design/**/*.png filter=lfs diff=lfs merge=lfs -text
.design/**/*.jpg filter=lfs diff=lfs merge=lfs -text
.design/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
.design/**/*.webp filter=lfs diff=lfs merge=lfs -text
.design/**/*.gif filter=lfs diff=lfs merge=lfs -text
.design/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
.design/**/*.mov filter=lfs diff=lfs merge=lfs -text
.design/**/*.pdf filter=lfs diff=lfs merge=lfs -text
