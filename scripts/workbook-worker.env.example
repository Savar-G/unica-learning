# Mac workbook worker settings template (see docs/workbook-worker.md and scripts/install-workbook-worker.sh).
# Copy to ~/.config/unica/workbook-worker.env (chmod 600), or point WORKBOOK_WORKER_ENV at another path.
# Never set these subscription CLI variables in Vercel.

# Supabase (leave SUPABASE_SECRET_KEY unset on macOS to read via Keychain item "supabase-pagewise")
# SUPABASE_URL=https://cdjobwsyzndtltzfpyqa.supabase.co
# SUPABASE_SECRET_KEY=

# Subscription provider: claude (default) or codex (Codex always disables the API fallback)
WORKBOOK_SUBSCRIPTION_PROVIDER=claude
# Required when WORKBOOK_SUBSCRIPTION_PROVIDER=codex: absolute directory holding auth.json
# WORKBOOK_CODEX_HOME=/absolute/path/to/selected-codex-home

# Claude CLI settings (used when WORKBOOK_SUBSCRIPTION_PROVIDER=claude)
# WORKBOOK_AI_PRIMARY=subscription
# WORKBOOK_CLAUDE_MODEL=claude-sonnet-5-5
# WORKBOOK_CLAUDE_SOLVE_MODEL=claude-haiku-5-5
# WORKBOOK_CLAUDE_CONFIG_DIR=
# WORKBOOK_CLAUDE_COMMAND=claude
# WORKBOOK_CLAUDE_TIMEOUT_MS=300000

# Dedicated OpenRouter API fallback (Claude mode only; shared OPENROUTER_API_KEY is disabled)
WORKBOOK_OPENROUTER_API_KEY=
# Optional learner/child profile findings (must be distinct from WORKBOOK_OPENROUTER_API_KEY)
# PROFILE_OPENROUTER_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5
# AI_SOLVE_MODEL=anthropic/claude-haiku-5.5

# Worker identity & local Chromium path for page printing
# WORKBOOK_WORKER_ID=
# CHROMIUM_PATH=
