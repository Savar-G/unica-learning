{
  "name": "unica-learning-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "build:ds": "node scripts/build-ds.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "db:types": "node scripts/db-types.mjs",
    "import:curriculum": "node scripts/import-curriculum.mjs",
    "audit:curriculum-templates": "node scripts/audit-curriculum-templates.mjs",
    "maya:text": "node scripts/maya-text.mjs",
    "maya:demo-child": "node scripts/maya-demo-child.mjs",
    "maya:practice": "node scripts/maya-practice.mjs",
    "voice:build": "node worker/maya-voice/build.mjs",
    "voice:typecheck": "tsc -p worker/maya-voice/tsconfig.json",
    "voice:test": "vitest run --config worker/maya-voice/vitest.config.mts",
    "voice:dev": "node worker/maya-voice/build.mjs && node --conditions=react-server worker/maya-voice/dist/main.mjs dev",
    "voice:start": "node --conditions=react-server worker/maya-voice/dist/main.mjs start",
    "workbooks:samples": "node scripts/workbook-samples.mjs",
    "workbook:fast": "node scripts/workbook-samples.mjs --fake --no-store --check-only --levels U4,U16 --days 1,5,10 --concurrency 3",
    "workbooks:worker": "node scripts/workbook-worker.mjs",
    "generate:family-zones": "node scripts/generate-family-zones.mjs",
    "test:family-zones": "node --expose-gc supabase/tests/maya_window_zones.cjs --bootstrap"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "jsqr": "^1.4.0",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "perfect-freehand": "^1.2.3",
    "posthog-js": "^1.435.8",
    "puppeteer-core": "^25.16.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@livekit/agents": "1.9.5",
    "@livekit/agents-plugin-assemblyai": "1.9.5",
    "@livekit/agents-plugin-inworld": "1.9.5",
    "@livekit/rtc-node": "^1.2.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "happy-dom": "^21.0.4",
    "pg": "8.16.3",
    "read-excel-file": "^9.3.14",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "module": "dist/ds/index.js",
  "types": "dist/ds/index.d.ts"
}
